<Project>

  <!--
    After a real build, extract the source-language template from the built assembly's IL (Decision D-K) by
    invoking the tool. Gated to build-only (never design-time), so editing in the IDE does not write files
    (Decision D-B). Extraction is per-authoring-assembly, so it runs only where the package is DIRECTLY
    referenced — the project that owns the strings; a project that gets the package transitively has no strings
    of its own and is skipped (it still gets the publish-time merge below). Set
    ArchPillarLocalizationExtractTransitively=true to run it anyway in a project that references the package
    indirectly or wires these targets in by hand (e.g. via Directory.Build) — the escape hatch. Best-effort: a
    missing tool warns rather than failing the build.
  -->
  <Target Name="ArchPillarLocalizationExtractTemplate"
          AfterTargets="Build"
          Condition="'$(ArchPillarLocalizationEmit)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'
                     and ('$(ArchPillarLocalizationExtractTransitively)' == 'true' or '@(PackageReference->WithMetadataValue('Identity', 'ArchPillar.Extensions.Localization'))' != '')">
    <!-- Opt out of annotation extraction (display names, descriptions, validation messages) when the consumer
         set ArchPillarLocalizationExtractAnnotations=false, leaving only the in-code call sites in the template. -->
    <PropertyGroup>
      <_ArchPillarExtractAnnotationsArg Condition="'$(ArchPillarLocalizationExtractAnnotations)' == 'false'">--no-annotations</_ArchPillarExtractAnnotationsArg>
      <!-- Opt IN to source-file references (which files each string is used in) with
           ArchPillarLocalizationExtractReferences=true. Off by default: a reference is a convenience for
           translators, not part of a string's identity, and it ties this git-tracked catalog to where the code
           happens to live — moving a call then rewrites the catalog for every language. Needs a PDB. -->
      <_ArchPillarExtractReferencesArg Condition="'$(ArchPillarLocalizationExtractReferences)' == 'true'">--references</_ArchPillarExtractReferencesArg>
    </PropertyGroup>
    <!-- The tool's output option, not its catalog-path option: this target already runs once per project and
         NormalizePath has resolved ArchPillarLocalizationCatalogPath to one exact directory, so there is nothing
         left for the tool to scope. The catalog-path option is for the tool discovering a scope itself; here
         MSBuild has already done that. -->
    <Exec Command="$(ArchPillarLocalizationToolCommand) extract --assembly &quot;$(TargetPath)&quot; --output &quot;$([MSBuild]::NormalizePath('$(ArchPillarLocalizationCatalogPath)'))&quot; --source $(ArchPillarLocalizationSourceLanguage) --format $(ArchPillarLocalizationFormat) $(_ArchPillarExtractAnnotationsArg) $(_ArchPillarExtractReferencesArg)"
          ContinueOnError="$(ArchPillarLocalizationToolContinueOnError)"
          StandardOutputImportance="low" />
  </Target>

  <!--
    Copies the catalogs beside the application binary, into a Translations folder, so the runtime's ambient
    directory source loads them. The catalogs are already named {AssemblyName}.{culture}.{ext} (the tool writes
    them that way), so two referenced libraries shipping (say) de never collide on one output path; they are
    copied as-is. The source-language catalog ({AssemblyName}.{SourceLanguage}.*) is copied too — it carries any
    edited source wording as overrides above the in-code default (its un-edited echoes are inert at runtime).
    Only the language-neutral Portable Object template (messages.pot) is excluded. Set
    ArchPillarLocalizationCopyTargetsToOutput=false to opt out (e.g. when embedding or merging at publish).

    Skipped for a Blazor WebAssembly app itself: a browser has no file system for the ambient directory source to
    read, so that app serves its own catalogs as static web assets over HTTP (below) and a copy beside its
    binaries is never loaded. UsingMicrosoftNETSdkBlazorWebAssembly is the same signal the catalog authority uses.

    This skip is the app's OWN catalogs only. A referenced library is not a WebAssembly project, so its copy runs
    and its catalogs flow up through the app into a hosting server's output — and that is wanted, not a leak: the
    host is a server, it reads the file system, and with server-side prerendering it renders the very components
    the client does, so its catalog set is a superset of the client's. Whether prerendering is on is not visible
    from here (only the reference graph is), and keeping files a static host never reads costs bytes while
    dropping files a prerendering host does read breaks it.
  -->
  <ItemGroup Condition="'$(ArchPillarLocalizationCopyTargetsToOutput)' == 'true' and '$(ArchPillarLocalizationEmbedTargets)' != 'true' and '$(UsingMicrosoftNETSdkBlazorWebAssembly)' != 'true' and Exists('$(ArchPillarLocalizationCatalogPath)')">
    <Content Include="$(ArchPillarLocalizationCatalogPath)\**\*.arb;$(ArchPillarLocalizationCatalogPath)\**\*.xliff;$(ArchPillarLocalizationCatalogPath)\**\*.xlf;$(ArchPillarLocalizationCatalogPath)\**\*.po"
             Exclude="$(ArchPillarLocalizationCatalogPath)\messages.pot"
             CopyToOutputDirectory="PreserveNewest"
             Link="Translations\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Opt-in (ArchPillarLocalizationEmbedTargets=true): embed the catalogs as standard per-culture SATELLITE
    assemblies instead of copying them as files — for single-file / self-contained publish. Catalogs are named
    {AssemblyName}.{culture}.{ext}, so the culture is the trailing dot-segment of the file name (App.de -> de);
    each lands in <culture>/<AssemblyName>.resources.dll, and the assembly is marked with
    [LocalizationSatelliteCatalogs] so the runtime probes it lazily per culture. The source-language catalog is
    embedded too (as the source-culture satellite) so any edited source wording ships as an override; its
    un-edited echoes are inert at runtime. For trimmed/AOT apps prefer the file (copy) path; embedded resources
    and satellites must be rooted against the trimmer.
  -->
  <ItemGroup Condition="'$(ArchPillarLocalizationEmbedTargets)' == 'true' and Exists('$(ArchPillarLocalizationCatalogPath)')">
    <EmbeddedResource Include="$(ArchPillarLocalizationCatalogPath)\*.arb;$(ArchPillarLocalizationCatalogPath)\*.xliff;$(ArchPillarLocalizationCatalogPath)\*.xlf"
                      Culture="$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)', '^.*\.', ''))"
                      Link="%(Filename)%(Extension)" />
    <AssemblyAttribute Include="ArchPillar.Extensions.Localization.LocalizationSatelliteCatalogsAttribute" />
  </ItemGroup>

  <!--
    On publish, flatten the per-library catalogs in the published Translations folder into one bundle per
    culture (the dev many-files layout becomes a production single-bundle-per-culture layout). This is the
    file-system layout used by a server/console app; a Blazor WebAssembly app serves catalogs as static web
    assets and merges them through the static web asset pipeline below instead, so this target is explicitly
    skipped there ('$(UsingMicrosoftNETSdkBlazorWebAssembly)' != 'true'). Do not rely on $(PublishDir)Translations
    being absent for a WebAssembly publish to skip it: a referenced Razor class library is not a WebAssembly
    project, so its own file copy runs and its catalogs flow up into the app's output as ordinary content, which
    can create $(PublishDir)Translations there. For a WebAssembly app those files are dead weight (the client
    never reads the file system), so they are removed instead of merged — see the cleanup target below. Best-
    effort: if the 'dotnet apl' tool is not installed the merge is skipped (ContinueOnError) and the per-library
    files are kept, so the app still works — just with more files. Set ArchPillarLocalizationMergeOnPublish=false
    to keep the many files. The merge reuses the runtime's load, so the bundle resolves identically.
  -->
  <Target Name="ArchPillarLocalizationMergeOnPublish"
          AfterTargets="Publish"
          Condition="'$(ArchPillarLocalizationMergeOnPublish)' == 'true' and '$(UsingMicrosoftNETSdkBlazorWebAssembly)' != 'true' and Exists('$(PublishDir)Translations')">
    <!--
      Start from a clean intermediate folder. Otherwise a merge that fails this run (ContinueOnError) would
      leave the previous run's bundles in place, and the swap below would publish those stale catalogs.
    -->
    <RemoveDir Directories="$(IntermediateOutputPath)apl-merged" />
    <Exec Command="$(ArchPillarLocalizationToolCommand) merge --input &quot;$([MSBuild]::NormalizePath('$(PublishDir)Translations'))&quot; --output &quot;$([MSBuild]::NormalizePath('$(IntermediateOutputPath)apl-merged'))&quot; --source $(ArchPillarLocalizationSourceLanguage) --format $(ArchPillarLocalizationBundleFormat)"
          ContinueOnError="$(ArchPillarLocalizationToolContinueOnError)"
          StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_ArchPillarMergeExitCode" />
    </Exec>
    <!-- Only consider the merged bundles when the tool actually succeeded (exit 0); a missing tool or a
         failed merge returns nonzero, leaving the item groups empty so the swap below is a no-op. -->
    <ItemGroup Condition="'$(_ArchPillarMergeExitCode)' == '0'">
      <_ArchPillarMergedCatalogs Include="$(IntermediateOutputPath)apl-merged\*" />
      <_ArchPillarPublishedCatalogs Include="$(PublishDir)Translations\*.arb;$(PublishDir)Translations\*.xliff;$(PublishDir)Translations\*.xlf;$(PublishDir)Translations\*.po" />
    </ItemGroup>
    <!-- Only swap when the merge succeeded and produced bundles; otherwise leave the per-library files in place. -->
    <Delete Files="@(_ArchPillarPublishedCatalogs)" Condition="'@(_ArchPillarMergedCatalogs)' != ''" />
    <Copy SourceFiles="@(_ArchPillarMergedCatalogs)"
          DestinationFiles="@(_ArchPillarMergedCatalogs->'$(PublishDir)Translations\%(Filename)%(Extension)')"
          Condition="'@(_ArchPillarMergedCatalogs)' != ''" />
  </Target>

  <!--
    A Blazor WebAssembly app serves its catalogs as static web assets under wwwroot/Translations and never reads
    the file system, so any $(PublishDir)Translations at the publish root is unreachable dead weight. It is not
    the app's own copy (that is suppressed above) but a referenced Razor class library's file copy flowing up as
    ordinary content; the merge target above is skipped for WebAssembly, so remove the folder here instead. Safe
    and idempotent: on an SDK/topology where the folder never appears, the RemoveDir is a no-op. This is the
    publish root ($(PublishDir)Translations), not the served wwwroot/Translations, so the client's catalogs are
    untouched.
  -->
  <Target Name="_ArchPillarLocalizationCleanWebAssemblyFileSystemCatalogs"
          AfterTargets="Publish"
          Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' and Exists('$(PublishDir)Translations')">
    <RemoveDir Directories="$(PublishDir)Translations" />
  </Target>

  <!--
    Serve the catalogs and their manifest (apl-catalogs.json) to a Blazor WebAssembly client as static web
    assets, so the client can fetch them over HTTP and discover what to load — a browser has no file system to
    enumerate. Catalogs are authored under OutputPath (not wwwroot), so they are not auto-discovered; they are
    registered explicitly through the static web asset pipeline, the way the SDK contributes its own computed
    assets (e.g. the JS-initializer module manifest), split by phase so AssetKind alone separates the two
    layouts (no asset removal):
      * Build   (ResolveStaticWebAssetsInputs): the per-library catalogs + a manifest listing them.
      * Publish (ResolvePublishStaticWebAssets): the catalogs merged into one bundle per culture + a manifest
                listing the bundles, so the published app ships the compact layout.
    Both hooks run late enough (PrepareForRun / the publish equivalent) that the tool is built and the
    source-language template has been extracted. These DependsOn properties exist only in Razor/Blazor
    projects, so this is inert elsewhere (a console/server app loads catalogs from the file system; see the
    publish-merge target above). The authority gathers each referenced localized library's catalogs (by trait)
    and merges them in — its own bundle/manifest are AssetMode=CurrentProject, but the referenced libraries
    contribute theirs as AssetMode=All so they flow up to be gathered. That same All propagation means a server
    host referencing the WebAssembly app re-gathers the libraries' raw catalogs one reference level past the
    authority, so a late prune (below) drops them from the host's published wwwroot.
  -->
  <PropertyGroup Condition="'$(ArchPillarLocalizationEmitManifest)' == 'true'">
    <!-- The Blazor WebAssembly app is the catalog "authority": it gathers every catalog static web asset (its
         own and each referenced library's) and emits the single manifest — and, on publish, merges them into one
         bundle per culture. A referenced Razor library is a "contributor": it registers its catalogs as static
         web assets that flow to the consuming app, and emits no manifest of its own. -->
    <_ArchPillarIsCatalogAuthority Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">true</_ArchPillarIsCatalogAuthority>

    <ResolveStaticWebAssetsInputsDependsOn>
      $(ResolveStaticWebAssetsInputsDependsOn);
      _ArchPillarLocalizationContributeCatalogs;
      _ArchPillarLocalizationAuthorBuildCatalogs
    </ResolveStaticWebAssetsInputsDependsOn>
    <ResolvePublishStaticWebAssetsDependsOn>
      $(ResolvePublishStaticWebAssetsDependsOn);
      _ArchPillarLocalizationAuthorPublishCatalogs
    </ResolvePublishStaticWebAssetsDependsOn>
  </PropertyGroup>

  <!--
    Teach the static web asset pipeline the catalog content types, so the endpoints serve a WebAssembly client's
    catalogs with a correct Content-Type. The SDK's built-in map does not know these extensions, so without this
    they are served as application/octet-stream (a runtime HttpClient fetch still reads them, but the type is
    wrong). APLOC (the default bundle) and ARB are JSON; XLIFF is XML; Portable Object is plain text. Matches the
    content types the ArchPillar.Extensions.Localization.AspNetCore package registers for the classic
    UseStaticFiles path.
  -->
  <ItemGroup Condition="'$(ArchPillarLocalizationEmitManifest)' == 'true'">
    <StaticWebAssetContentTypeMapping Include="application/json" Pattern="*.aploc" Priority="1" Cache="$(StaticWebAssetEndpointDefaultMediaCacheControlHeader)" />
    <StaticWebAssetContentTypeMapping Include="application/json" Pattern="*.arb" Priority="1" Cache="$(StaticWebAssetEndpointDefaultMediaCacheControlHeader)" />
    <StaticWebAssetContentTypeMapping Include="application/xml" Pattern="*.xliff" Priority="1" Cache="$(StaticWebAssetEndpointDefaultMediaCacheControlHeader)" />
    <StaticWebAssetContentTypeMapping Include="application/xml" Pattern="*.xlf" Priority="1" Cache="$(StaticWebAssetEndpointDefaultMediaCacheControlHeader)" />
    <StaticWebAssetContentTypeMapping Include="text/plain" Pattern="*.po" Priority="1" Cache="$(StaticWebAssetEndpointDefaultMediaCacheControlHeader)" />
    <StaticWebAssetContentTypeMapping Include="text/plain" Pattern="*.pot" Priority="1" Cache="$(StaticWebAssetEndpointDefaultMediaCacheControlHeader)" />
  </ItemGroup>

  <!-- Reusable globs for a project's own loose catalogs. The source-language catalog is included (it carries
       edited source wording as overrides; its echoes are inert), so only the neutral PO template is excluded. -->
  <PropertyGroup Condition="'$(ArchPillarLocalizationEmitManifest)' == 'true'">
    <_ArchPillarCatalogRoot>$([MSBuild]::NormalizeDirectory('$(ArchPillarLocalizationCatalogPath)'))</_ArchPillarCatalogRoot>
    <_ArchPillarCatalogInclude>$(_ArchPillarCatalogRoot)*.arb;$(_ArchPillarCatalogRoot)*.xliff;$(_ArchPillarCatalogRoot)*.xlf;$(_ArchPillarCatalogRoot)*.po</_ArchPillarCatalogInclude>
    <_ArchPillarCatalogExclude>$(_ArchPillarCatalogRoot)messages.pot</_ArchPillarCatalogExclude>
  </PropertyGroup>

  <!--
    Contributor (a referenced Razor library): register this library's own catalogs as static web assets with
    AssetMode=All so they flow to the consuming app, tagged so the app can find them. No manifest — the app
    authors it. Skipped on the authority (the WebAssembly app gathers its own catalogs directly below).
  -->
  <Target Name="_ArchPillarLocalizationContributeCatalogs"
          Condition="'$(ArchPillarLocalizationEmitManifest)' == 'true' and '$(_ArchPillarIsCatalogAuthority)' != 'true' and '$(OutputType)' == 'Library' and Exists('$(ArchPillarLocalizationCatalogPath)')">
    <ItemGroup>
      <_ArchPillarOwnCatalogRaw Include="$(_ArchPillarCatalogInclude)" Exclude="$(_ArchPillarCatalogExclude)" />
      <_ArchPillarOwnCatalog Include="@(_ArchPillarOwnCatalogRaw)">
        <RelativePath>Translations/%(Filename)%(Extension)</RelativePath>
      </_ArchPillarOwnCatalog>
    </ItemGroup>

    <DefineStaticWebAssets Condition="'@(_ArchPillarOwnCatalog)' != ''"
      CandidateAssets="@(_ArchPillarOwnCatalog)"
      SourceId="$(PackageId)" SourceType="Computed"
      BasePath="$(StaticWebAssetBasePath)" ContentRoot="$(_ArchPillarCatalogRoot)"
      AssetKind="All" AssetMode="All" AssetRole="Primary"
      AssetTraitName="ArchPillarLocalizationCatalog" AssetTraitValue="Catalog"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)" FingerprintPatterns="@(StaticWebAssetFingerprintPattern)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_ArchPillarContributedCatalog" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints Condition="'@(_ArchPillarContributedCatalog)' != ''"
      CandidateAssets="@(_ArchPillarContributedCatalog)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

  <!--
    Authority (build): gather the app's own catalogs (loose files in OutputPath) and every referenced library's
    catalog assets (by trait), collect them into one folder, and re-home them under Translations/ as Build
    assets, then emit one manifest listing them. The referenced assets are removed at their original
    _content/<lib>/ location so each catalog is served once.

    The re-homed catalogs and the manifest are registered AssetMode=All, not CurrentProject. In a hosted layout
    the project that produces the deployed wwwroot is the server host, not this WebAssembly app, and a
    CurrentProject asset does not cross a ProjectReference (SDK versions before it began forwarding a referenced
    WebAssembly app's own assets), so the manifest and bundles never reach the host — the app ships with the
    contributor's raw catalogs (which ARE All and do propagate) but nothing pointing at them. All propagates the
    same way the contributor's do, covering both the standalone publish and a hosting server.
  -->
  <!--
    The authority's third catalog channel: a referenced library that is NOT a Razor/Blazor project.

    A contributor registers its catalogs as static web assets from a target hooked onto
    ResolveStaticWebAssetsInputsDependsOn — a property that exists only under the Razor/Blazor SDK. A plain
    Microsoft.NET.Sdk library (a contracts or model project that only annotates its types) therefore never runs
    it and produces no static web asset for the authority to find by trait, with no supported way to opt in. Its
    catalogs still reach the consuming app, but only down the file-copy path — Content linked to Translations\ —
    which for a browser is dead weight: there is no file system for the directory source to read. The catalog was
    extracted, translated, and silently unreachable, with nothing to warn on.

    So gather that channel too. GetCopyToOutputDirectoryItems populates the transitive copy items, whose
    TargetPath is the Translations\ link the copy path already assigns, which is exactly the set of referenced
    catalogs travelling as files. A Razor library's catalogs arrive through both channels; the collect directory
    is keyed by file name, so the duplicate resolves to one file with no dedup pass. Gathering only ever adds to
    the manifest, so a library that already worked keeps working.
  -->
  <Target Name="_ArchPillarLocalizationGatherCopiedCatalogs"
          Condition="'$(ArchPillarLocalizationEmitManifest)' == 'true' and '$(_ArchPillarIsCatalogAuthority)' == 'true'">
    <ItemGroup>
      <_ArchPillarCopiedCatalogCandidate Include="@(_TransitiveItemsToCopyToOutputDirectory)"
                                         Condition="'%(_TransitiveItemsToCopyToOutputDirectory.Extension)' == '.arb'
                                                 or '%(_TransitiveItemsToCopyToOutputDirectory.Extension)' == '.xliff'
                                                 or '%(_TransitiveItemsToCopyToOutputDirectory.Extension)' == '.xlf'
                                                 or '%(_TransitiveItemsToCopyToOutputDirectory.Extension)' == '.po'" />
      <!-- Only those the copy path homed under Translations\ are catalogs; other content keeps its own layout.
           The separator is written as it appears in the link metadata, so match on the folder name alone. -->
      <_ArchPillarCopiedCatalog Include="@(_ArchPillarCopiedCatalogCandidate)"
                                Condition="$([System.String]::Copy('%(_ArchPillarCopiedCatalogCandidate.TargetPath)').StartsWith('Translations'))" />
    </ItemGroup>
  </Target>

  <Target Name="_ArchPillarLocalizationAuthorBuildCatalogs" DependsOnTargets="GetCopyToOutputDirectoryItems;_ArchPillarLocalizationGatherCopiedCatalogs"
          Condition="'$(ArchPillarLocalizationEmitManifest)' == 'true' and '$(_ArchPillarIsCatalogAuthority)' == 'true'">
    <PropertyGroup>
      <_ArchPillarBuildCollectDir>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)apl-build'))</_ArchPillarBuildCollectDir>
      <_ArchPillarBuildManifestDir>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)apl-build-manifest'))</_ArchPillarBuildManifestDir>
    </PropertyGroup>

    <ItemGroup>
      <_ArchPillarOwnCatalogFile Condition="Exists('$(ArchPillarLocalizationCatalogPath)')" Include="$(_ArchPillarCatalogInclude)" Exclude="$(_ArchPillarCatalogExclude)" />
      <_ArchPillarReferencedCatalog Include="@(StaticWebAsset)" Condition="'%(StaticWebAsset.AssetTraitName)' == 'ArchPillarLocalizationCatalog'" />
    </ItemGroup>

    <RemoveDir Directories="$(_ArchPillarBuildCollectDir)" />
    <MakeDir Directories="$(_ArchPillarBuildCollectDir)" />
    <Copy Condition="'@(_ArchPillarOwnCatalogFile)@(_ArchPillarReferencedCatalog)@(_ArchPillarCopiedCatalog)' != ''"
          SourceFiles="@(_ArchPillarOwnCatalogFile);@(_ArchPillarReferencedCatalog);@(_ArchPillarCopiedCatalog)"
          DestinationFolder="$(_ArchPillarBuildCollectDir)" />

    <ItemGroup>
      <!-- The referenced catalogs are re-homed under Translations/; drop them at their _content/<lib>/ origin. -->
      <StaticWebAsset Remove="@(_ArchPillarReferencedCatalog)" />

      <_ArchPillarBuildCollected Include="$(_ArchPillarBuildCollectDir)*.arb;$(_ArchPillarBuildCollectDir)*.xliff;$(_ArchPillarBuildCollectDir)*.xlf;$(_ArchPillarBuildCollectDir)*.po" />
      <_ArchPillarBuildCatalog Include="@(_ArchPillarBuildCollected)">
        <RelativePath>Translations/%(Filename)%(Extension)</RelativePath>
      </_ArchPillarBuildCatalog>
    </ItemGroup>

    <DefineStaticWebAssets Condition="'@(_ArchPillarBuildCatalog)' != ''"
      CandidateAssets="@(_ArchPillarBuildCatalog)"
      SourceId="$(PackageId)" SourceType="Computed"
      BasePath="$(StaticWebAssetBasePath)" ContentRoot="$(_ArchPillarBuildCollectDir)"
      AssetKind="Build" AssetMode="All" AssetRole="Primary"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)" FingerprintPatterns="@(StaticWebAssetFingerprintPattern)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_ArchPillarBuildCatalogAsset" />
    </DefineStaticWebAssets>

    <MakeDir Condition="'@(_ArchPillarBuildCatalog)' != ''" Directories="$(_ArchPillarBuildManifestDir)" />
    <!-- Trim the trailing separator off the collect dir before quoting it: the property keeps its slash for the
         globbing and ContentRoot above, but a double-quoted path that ends in a backslash escapes the closing
         quote on Windows, so the tool would receive a single mangled input value (the output and source options
         swallowed into it) and exit 2. NormalizePath would not help here: it preserves a trailing separator that
         is already present, so the separator must be trimmed explicitly. -->
    <Exec Condition="'@(_ArchPillarBuildCatalog)' != ''"
          Command="$(ArchPillarLocalizationToolCommand) manifest --input &quot;$([System.IO.Path]::TrimEndingDirectorySeparator('$(_ArchPillarBuildCollectDir)'))&quot; --output &quot;$(_ArchPillarBuildManifestDir)apl-catalogs.json&quot; --source $(ArchPillarLocalizationSourceLanguage)"
          ContinueOnError="$(ArchPillarLocalizationToolContinueOnError)" StandardOutputImportance="low" />

    <!-- The manifest is not optional for a WebAssembly client: with no file system to enumerate it is the only
         way the runtime discovers what to fetch, so a missing one is a broken app, not a degraded one. The tool
         invocations stay best-effort ($(ArchPillarLocalizationToolContinueOnError)) so a warning does not fail an
         ordinary build, but here — the authority has catalogs yet produced no manifest — that best-effort miss
         must surface, or the WebAssembly app ships silently un-localized. Held to real builds ('DesignTimeBuild'
         != 'true') so an IDE's background build does not spam the error before the tool is even restored. -->
    <Error Condition="'@(_ArchPillarBuildCatalog)' != '' and '$(DesignTimeBuild)' != 'true' and !Exists('$(_ArchPillarBuildManifestDir)apl-catalogs.json')"
           Code="APL0100"
           Text="Could not generate the Blazor WebAssembly catalog manifest (apl-catalogs.json). A WebAssembly client discovers its translation catalogs only through this manifest, so it is required. The '$(ArchPillarLocalizationToolCommand)' tool did not produce it — install the ArchPillar localization tool (dotnet tool install --global ArchPillar.Extensions.Localization.Tooling, or add it to a local .config/dotnet-tools.json manifest and run dotnet tool restore) so 'dotnet apl' resolves during the build, then rebuild. See the build log above for the tool's own error." />

    <ItemGroup>
      <_ArchPillarBuildManifestFile Include="$(_ArchPillarBuildManifestDir)apl-catalogs.json" Condition="Exists('$(_ArchPillarBuildManifestDir)apl-catalogs.json')">
        <RelativePath>Translations/apl-catalogs.json</RelativePath>
      </_ArchPillarBuildManifestFile>
    </ItemGroup>
    <DefineStaticWebAssets Condition="'@(_ArchPillarBuildManifestFile)' != ''"
      CandidateAssets="@(_ArchPillarBuildManifestFile)" SourceId="$(PackageId)" SourceType="Computed"
      BasePath="$(StaticWebAssetBasePath)" ContentRoot="$(_ArchPillarBuildManifestDir)"
      AssetKind="Build" AssetMode="All" AssetRole="Primary"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)" FingerprintPatterns="@(StaticWebAssetFingerprintPattern)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_ArchPillarBuildManifestAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints Condition="'@(_ArchPillarBuildCatalogAsset)@(_ArchPillarBuildManifestAsset)' != ''"
      CandidateAssets="@(_ArchPillarBuildCatalogAsset);@(_ArchPillarBuildManifestAsset)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

  <!--
    Authority (publish): same gather as the build, but flatten the app's own and every referenced library's
    catalogs into one bundle per culture, register the bundles, and remove the per-library catalogs from the
    publish set so only the bundles ship. Bundles and manifest are AssetMode=All (see the build twin above) so
    they reach a server host that publishes this WebAssembly app through a ProjectReference; the client's base
    path is the app root (/), so they land at the host's wwwroot/Translations, where the client fetches them.
  -->
  <Target Name="_ArchPillarLocalizationAuthorPublishCatalogs" DependsOnTargets="GetCopyToOutputDirectoryItems;_ArchPillarLocalizationGatherCopiedCatalogs"
          Condition="'$(ArchPillarLocalizationEmitManifest)' == 'true' and '$(_ArchPillarIsCatalogAuthority)' == 'true'">
    <PropertyGroup>
      <_ArchPillarPubCollectDir>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)apl-pub'))</_ArchPillarPubCollectDir>
      <_ArchPillarBundleDir>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)apl-pub-bundles'))</_ArchPillarBundleDir>
      <_ArchPillarPubManifestDir>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)apl-pub-manifest'))</_ArchPillarPubManifestDir>
    </PropertyGroup>

    <ItemGroup>
      <_ArchPillarOwnCatalogFile Condition="Exists('$(ArchPillarLocalizationCatalogPath)')" Include="$(_ArchPillarCatalogInclude)" Exclude="$(_ArchPillarCatalogExclude)" />
      <_ArchPillarReferencedCatalog Include="@(StaticWebAsset)" Condition="'%(StaticWebAsset.AssetTraitName)' == 'ArchPillarLocalizationCatalog'" />
    </ItemGroup>

    <RemoveDir Directories="$(_ArchPillarPubCollectDir);$(_ArchPillarBundleDir)" />
    <MakeDir Directories="$(_ArchPillarPubCollectDir);$(_ArchPillarBundleDir);$(_ArchPillarPubManifestDir)" />
    <Copy Condition="'@(_ArchPillarOwnCatalogFile)@(_ArchPillarReferencedCatalog)@(_ArchPillarCopiedCatalog)' != ''"
          SourceFiles="@(_ArchPillarOwnCatalogFile);@(_ArchPillarReferencedCatalog);@(_ArchPillarCopiedCatalog)"
          DestinationFolder="$(_ArchPillarPubCollectDir)" />

    <!-- Trim the trailing separators before quoting (see the build manifest call above): a double-quoted path
         ending in a separator escapes the closing quote on Windows, mangling the argument. Both dirs need it. -->
    <Exec Condition="'@(_ArchPillarOwnCatalogFile)@(_ArchPillarReferencedCatalog)@(_ArchPillarCopiedCatalog)' != ''"
          Command="$(ArchPillarLocalizationToolCommand) merge --input &quot;$([System.IO.Path]::TrimEndingDirectorySeparator('$(_ArchPillarPubCollectDir)'))&quot; --output &quot;$([System.IO.Path]::TrimEndingDirectorySeparator('$(_ArchPillarBundleDir)'))&quot; --source $(ArchPillarLocalizationSourceLanguage) --format $(ArchPillarLocalizationBundleFormat)"
          ContinueOnError="$(ArchPillarLocalizationToolContinueOnError)" StandardOutputImportance="low" />

    <ItemGroup>
      <!-- The bundles replace the per-library catalogs; drop the referenced ones from the publish set. -->
      <StaticWebAsset Remove="@(_ArchPillarReferencedCatalog)" />

      <_ArchPillarBundleRaw Include="$(_ArchPillarBundleDir)*.aploc;$(_ArchPillarBundleDir)*.arb;$(_ArchPillarBundleDir)*.xliff;$(_ArchPillarBundleDir)*.xlf;$(_ArchPillarBundleDir)*.po" />
      <_ArchPillarBundle Include="@(_ArchPillarBundleRaw)">
        <RelativePath>Translations/%(Filename)%(Extension)</RelativePath>
      </_ArchPillarBundle>
    </ItemGroup>

    <DefineStaticWebAssets Condition="'@(_ArchPillarBundle)' != ''"
      CandidateAssets="@(_ArchPillarBundle)"
      SourceId="$(PackageId)" SourceType="Computed"
      BasePath="$(StaticWebAssetBasePath)" ContentRoot="$(_ArchPillarBundleDir)"
      AssetKind="Publish" AssetMode="All" AssetRole="Primary"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)" FingerprintPatterns="@(StaticWebAssetFingerprintPattern)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_ArchPillarPubBundleAsset" />
    </DefineStaticWebAssets>

    <!-- Trim the trailing separator before quoting, as above. -->
    <Exec Condition="'@(_ArchPillarBundle)' != ''"
          Command="$(ArchPillarLocalizationToolCommand) manifest --input &quot;$([System.IO.Path]::TrimEndingDirectorySeparator('$(_ArchPillarBundleDir)'))&quot; --output &quot;$(_ArchPillarPubManifestDir)apl-catalogs.json&quot; --source $(ArchPillarLocalizationSourceLanguage)"
          ContinueOnError="$(ArchPillarLocalizationToolContinueOnError)" StandardOutputImportance="low" />

    <!-- As at build (see APL0100 above), the manifest is mandatory for a WebAssembly client, so a best-effort
         miss must fail publish rather than ship an un-localized app. This also covers a failed merge: no bundles
         means the manifest Exec is skipped, so the manifest is absent and this fires. The referenced catalogs
         were already dropped from the publish set above, so stopping here is correct — nothing half-merged ships. -->
    <Error Condition="'@(_ArchPillarOwnCatalogFile)@(_ArchPillarReferencedCatalog)' != '' and !Exists('$(_ArchPillarPubManifestDir)apl-catalogs.json')"
           Code="APL0100"
           Text="Could not generate the Blazor WebAssembly catalog manifest (apl-catalogs.json) for publish. A WebAssembly client discovers its translation catalogs only through this manifest, so it is required. The '$(ArchPillarLocalizationToolCommand)' tool did not merge the catalogs or write the manifest — install the ArchPillar localization tool (dotnet tool install --global ArchPillar.Extensions.Localization.Tooling, or add it to a local .config/dotnet-tools.json manifest and run dotnet tool restore) so 'dotnet apl' resolves during publish, then republish. See the build log above for the tool's own error." />

    <ItemGroup>
      <_ArchPillarPubManifestFile Include="$(_ArchPillarPubManifestDir)apl-catalogs.json" Condition="Exists('$(_ArchPillarPubManifestDir)apl-catalogs.json')">
        <RelativePath>Translations/apl-catalogs.json</RelativePath>
      </_ArchPillarPubManifestFile>
    </ItemGroup>
    <DefineStaticWebAssets Condition="'@(_ArchPillarPubManifestFile)' != ''"
      CandidateAssets="@(_ArchPillarPubManifestFile)" SourceId="$(PackageId)" SourceType="Computed"
      BasePath="$(StaticWebAssetBasePath)" ContentRoot="$(_ArchPillarPubManifestDir)"
      AssetKind="Publish" AssetMode="All" AssetRole="Primary"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)" FingerprintPatterns="@(StaticWebAssetFingerprintPattern)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_ArchPillarPubManifestAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints Condition="'@(_ArchPillarPubBundleAsset)@(_ArchPillarPubManifestAsset)' != ''"
      CandidateAssets="@(_ArchPillarPubBundleAsset);@(_ArchPillarPubManifestAsset)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

  <!--
    Drop the raw per-library catalogs a contributor registered (trait-tagged) from the published set, in whatever
    project produces the final wwwroot. They exist only so the authority can gather and merge them; once it has
    emitted the manifest (and the per-culture bundles) they are superseded and must not ship.

    They matter here because they propagate as AssetMode=All: a server host that references the WebAssembly app
    re-gathers each library's catalogs straight from the library — one reference level past the authority — so the
    authority's own <StaticWebAsset Remove> never reaches them and they leak into the host's
    wwwroot/_content/<library>/Translations. Pruning has to happen where the published files are computed: the
    copy reads @(StaticWebAsset) in _SplitPublishStaticWebAssetsByCopyOptions, after ResolvePublishStaticWebAssets
    has re-materialized the referenced assets — so a removal wired into ResolvePublishStaticWebAssetsDependsOn is
    overwritten. Hook the copy directly instead (after CopyStaticWebAssetsToPublishDirectory has fully resolved
    @(StaticWebAsset), before the split copies it and before the endpoint manifest is written). Removing the asset
    is enough: the endpoint manifest is generated from the surviving assets, so the pruned catalogs' endpoints go
    with them (this is the same asset-only removal the authority uses). Self-limited to when the authority's
    manifest is present: without it there is nothing to supersede the raw catalogs, so they are left as the only
    fallback rather than stripped to nothing.
  -->
  <Target Name="_ArchPillarLocalizationPruneContributedCatalogs"
          Condition="'$(ArchPillarLocalizationEmitManifest)' == 'true'"
          AfterTargets="CopyStaticWebAssetsToPublishDirectory"
          BeforeTargets="_SplitPublishStaticWebAssetsByCopyOptions;GenerateStaticWebAssetsPublishManifest">
    <ItemGroup>
      <_ArchPillarContributedCatalogAsset Include="@(StaticWebAsset)" Condition="'%(StaticWebAsset.AssetTraitName)' == 'ArchPillarLocalizationCatalog'" />
      <!-- The manifest's RelativePath carries the fingerprint-expression form (apl-catalogs#[.{fingerprint}]?.json),
           so match on the stem, not the full 'apl-catalogs.json' file name. -->
      <_ArchPillarResolvedManifestAsset Include="@(StaticWebAsset)" Condition="$([System.String]::new('%(StaticWebAsset.RelativePath)').Contains('apl-catalogs'))" />
    </ItemGroup>

    <ItemGroup Condition="'@(_ArchPillarResolvedManifestAsset)' != '' and '@(_ArchPillarContributedCatalogAsset)' != ''">
      <StaticWebAsset Remove="@(_ArchPillarContributedCatalogAsset)" />
    </ItemGroup>
  </Target>

</Project>

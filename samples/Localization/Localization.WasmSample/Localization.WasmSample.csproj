<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Catalogs are authored under the default OutputPath (Translations/, not wwwroot). The build registers
         them and the apl-catalogs.json manifest as static web assets through the Razor pipeline (per-library at
         build, merged per-culture bundles at publish), so the client fetches them over HTTP. The beside-the-binary
         file copy (ArchPillarLocalizationCopyTargetsToOutput) is skipped automatically for a WebAssembly app — a
         browser has no file system to read it — so this project sets nothing to opt out. -->
    <!-- This sample is trimmed by default (Blazor WASM) but must still author + serve its catalogs through the
         build pipeline, so it opts into the samples' authoring wiring explicitly. -->
    <ArchPillarLocalizationSampleAuthoring>true</ArchPillarLocalizationSampleAuthoring>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
    <RootNamespace>Localization.WasmSample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Localization\ArchPillar.Extensions.Localization.csproj" />
    <ProjectReference Include="..\..\..\src\Localization.StringLocalizer\ArchPillar.Extensions.Localization.StringLocalizer.csproj" />
    <ProjectReference Include="..\..\..\src\Localization.WebAssembly\ArchPillar.Extensions.Localization.WebAssembly.csproj" />
    <!-- A referenced localized library: the build must gather and merge its catalogs into this app's manifest. -->
    <ProjectReference Include="..\Localization.WasmLibrary\Localization.WasmLibrary.csproj" />
    <ProjectReference Include="..\Localization.WasmContracts\Localization.WasmContracts.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
    <RootNamespace>Localization.WasmHostSample</RootNamespace>
    <!-- The host authors no translatable strings of its own; it only serves the WebAssembly client. It still
         opts into the samples' authoring wiring so it imports the package's build targets the way a real
         consumer gets them transitively (buildTransitive) — that is what runs the publish-time prune that keeps
         the referenced libraries' raw catalogs from leaking into this host's wwwroot/_content. -->
    <ArchPillarLocalizationSampleAuthoring>true</ArchPillarLocalizationSampleAuthoring>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server hosts this Blazor WebAssembly client (which itself references a localized Razor library). -->
    <ProjectReference Include="..\Localization.WasmSample\Localization.WasmSample.csproj" />
  </ItemGroup>

</Project>

<Project>
    <PropertyGroup>
        <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- ================================================================== -->
    <!-- Framework-specific: .NET 8                                         -->
    <!-- ================================================================== -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.33" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.33" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.33" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.33" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.33" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.33" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.33" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Extensions.Localization" Version="8.0.33" />
        <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="8.0.33" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    </ItemGroup>

    <!-- ================================================================== -->
    <!-- Framework-specific: .NET 9                                         -->
    <!-- ================================================================== -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.22" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.22" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.22" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.22" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.22" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.22" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.22" />
        <PackageVersion Include="Microsoft.Extensions.Localization" Version="9.0.22" />
        <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="9.0.22" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.22" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.22" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.22" />
    </ItemGroup>

    <!-- ================================================================== -->
    <!-- Framework-specific: .NET 10                                        -->
    <!-- ================================================================== -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
        <!-- Upgrades for the NuGet security audit (NU1903). -->
        <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
        <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    </ItemGroup>

    <!-- ================================================================== -->
    <!-- Framework-agnostic                                                 -->
    <!-- ================================================================== -->
    <ItemGroup>
        <PackageVersion Include="OpenIddict.AspNetCore" Version="7.8.0" />
        <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.8.0" />
        <PackageVersion Include="Bogus" Version="35.6.5" />
        <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
        <PackageVersion Include="Spectre.Console" Version="0.57.2" />
        <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
    </ItemGroup>
    <ItemGroup>
        <!--Brixter private packages-->
        <PackageVersion Include="Brixter.Extensions.AspNetCore.OpenApi" Version="0.4.6" />
    </ItemGroup>
    <ItemGroup>
        <!-- Source Link -->
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    </ItemGroup>
    <ItemGroup>
        <!-- Roslyn (analyzers + source generator); host-provided, referenced PrivateAssets=all.
             Pinned to 4.14.0 so it does not downgrade BenchmarkDotNet's transitive requirement. -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
        <!-- IL reading for the dotnet tool's assembly-based extraction (D-K). A tool-only dependency: the
             tool is a separate global tool, never shipped in a consumer's product, so the runtime stays
             dependency-free. -->
        <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    </ItemGroup>
    <ItemGroup>
        <!-- Analyzers -->
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
        <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
        <PackageVersion Include="SecurityCodeScan.VS2019" Version="5.6.7" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    </ItemGroup>
    <ItemGroup>
        <!-- Testing -->
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="BenchmarkDotNet.Annotations" Version="0.15.8" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <!-- End of Testing -->
    </ItemGroup>
</Project>
